# My-devin Environment Variables

# LLM Settings
LLM_PROVIDER=lm-studio  # lm-studio, ollama, mlx
DEFAULT_MODEL=qwen2.5-coder-32b-instruct

# LM Studio Settings (推奨)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Ollama Settings (オプション)
OLLAMA_BASE_URL=http://localhost:11434

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Project Settings
WORKSPACE_DIR=./workspace

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=false

# Frontend
VITE_API_URL=http://localhost:8000
